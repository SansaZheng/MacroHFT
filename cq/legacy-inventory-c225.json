{
  "name": "MacroHFT legacy c225 read-only inventory after repository allowlisting",
  "work": "MacroHFT",
  "code": {
    "git": "SansaZheng/MacroHFT",
    "commit": "6c164570461c269d04ed2cee719247beb3317d50"
  },
  "command": [
    "python3",
    "scripts/cq_inventory.py",
    "--root",
    "/date/zyy/macrohft-reproduction"
  ],
  "resources": {
    "gpus": 0,
    "cpus": 1,
    "ram_gb": 1,
    "disk_gb": 4
